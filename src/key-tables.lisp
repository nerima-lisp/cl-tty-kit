(in-package #:cl-tty-kit)

(defparameter +csi-final-events+
  '((#\A . :up)
    (#\B . :down)
    (#\C . :right)
    (#\D . :left)
    (#\H . :home)
    (#\F . :end)
    (#\Z . :backtab)
    ;; Focus reporting (DEC private mode 1004): `ESC [ I' / `ESC [ O'.
    (#\I . :focus-in)
    (#\O . :focus-out)))

